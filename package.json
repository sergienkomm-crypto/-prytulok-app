{
  "name": "prytulok-app",
  "license": "0BSD",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.22",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.4",
    "expo-doctor": "^1.0.0"
  },
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --go --android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "doctor": "expo-doctor",
    "check": "npm run typecheck && npm run lint",
    "export:android": "expo export --platform android --output-dir dist/android",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist/web"
  },
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  }
}
